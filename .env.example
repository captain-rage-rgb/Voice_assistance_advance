# ==============================================================================
# Real-Time Voice Computer Agent - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and adjust settings as appropriate.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application & Logging
APP_ENV=development
LOG_LEVEL=INFO

# Audio & Microphone Configuration
# AUDIO_SAMPLE_RATE=16000
# AUDIO_CHANNELS=1
# AUDIO_CHUNK_DURATION_MS=30
# AUDIO_DEVICE_INDEX=
# AUDIO_QUEUE_MAX_SIZE=100

# VAD & Endpointing
# VAD_AGGRESSIVENESS=2
# VAD_SPEECH_START_FRAMES=3
# VAD_SPEECH_END_FRAMES=25

# Speech-to-Text (STT) Streaming Configuration
STT_PROVIDER=deepgram
STT_API_KEY=your_deepgram_api_key_here
STT_MODEL=nova-2
STT_LANGUAGE=en-US
STT_ENDPOINTING_MS=500

# Future Integrations (Placeholders for upcoming phases - NOT ACTIVE IN PHASE 4)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
